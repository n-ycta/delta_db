{
  "id": "storage",
  "description": "Unified replaceable storage transport",
  "metadata": {
    "storageContract": "1.1.0",
    "ui": {
      "id": "dev.delta.db",
      "name": "Delta Storage",
      "version": "0.3.0",
      "contract": "^1.4.0",
      "publisher": "Delta",
      "description": "Unified storage with local files or PostgreSQL (TimescaleDB optional).",
      "icon": "database",
      "category": "system",
      "runtime": {
        "targets": [
          "vps",
          "desktop",
          "container"
        ]
      },
      "metrics": [],
      "capabilities": [
        "storage.local",
        "settings.read",
        "status.read"
      ],
      "repository": "https://github.com/n-ycta/delta_db",
      "defaultLocale": "en",
      "screenshots": [
        {
          "url": "https://raw.githubusercontent.com/n-ycta/delta/main/docs/images/storage-settings.png",
          "alt": "Storage backend settings"
        }
      ],
      "localizations": {
        "en": {
          "name": "Delta Storage",
          "publisher": "Delta",
          "description": "Unified storage with local files or PostgreSQL (TimescaleDB optional).",
          "icon": "database",
          "category": "system",
          "metrics": [],
          "permissions": [
            {
              "scope": "register:storage",
              "reason": "Required runtime authority. This is executable plugin code, not a sandbox.",
              "optional": false
            },
            {
              "scope": "call:storage.*",
              "reason": "Required runtime authority. This is executable plugin code, not a sandbox.",
              "optional": false
            }
          ],
          "settings": [
            {
              "key": "engine",
              "type": "select",
              "label": "Storage engine",
              "default": "file",
              "options": [
                {
                  "value": "file",
                  "label": "Local files (quick start)"
                },
                {
                  "value": "postgres",
                  "label": "PostgreSQL (TimescaleDB optional)"
                }
              ]
            },
            {
              "key": "databaseUrl",
              "type": "secret",
              "label": "PostgreSQL connection URL",
              "help": "Stored privately on this node. Leave blank to retain the current connection."
            },
            {
              "key": "confirmBackendChange",
              "type": "boolean",
              "label": "I understand that switching engines does not migrate existing data",
              "default": false
            }
          ]
        },
        "ru": {
          "name": "Delta Storage",
          "publisher": "Delta",
          "description": "Единое хранилище: локальные файлы или PostgreSQL (TimescaleDB необязателен).",
          "icon": "database",
          "category": "system",
          "metrics": [],
          "permissions": [
            {
              "scope": "register:storage",
              "reason": "Необходимые права процесса. Плагин исполняет код на узле без песочницы.",
              "optional": false
            },
            {
              "scope": "call:storage.*",
              "reason": "Необходимые права процесса. Плагин исполняет код на узле без песочницы.",
              "optional": false
            }
          ],
          "settings": [
            {
              "key": "engine",
              "label": "Движок хранения",
              "options": [
                {
                  "value": "file",
                  "label": "Локальные файлы"
                },
                {
                  "value": "postgres",
                  "label": "PostgreSQL (TimescaleDB необязателен)"
                }
              ]
            },
            {
              "key": "databaseUrl",
              "label": "Строка подключения PostgreSQL",
              "help": "Хранится приватно на узле. Оставьте пустым, чтобы сохранить текущее подключение."
            },
            {
              "key": "confirmBackendChange",
              "label": "Я понимаю, что смена движка не переносит существующие данные"
            }
          ]
        }
      },
      "permissions": [
        {
          "scope": "register:storage",
          "reason": "Required runtime authority. This is executable plugin code, not a sandbox.",
          "optional": false
        },
        {
          "scope": "call:storage.*",
          "reason": "Required runtime authority. This is executable plugin code, not a sandbox.",
          "optional": false
        }
      ],
      "settings": [
        {
          "key": "engine",
          "type": "select",
          "label": "Storage engine",
          "default": "file",
          "options": [
            {
              "value": "file",
              "label": "Local files (quick start)"
            },
            {
              "value": "postgres",
              "label": "PostgreSQL (TimescaleDB optional)"
            }
          ]
        },
        {
          "key": "databaseUrl",
          "type": "secret",
          "label": "PostgreSQL connection URL",
          "help": "Stored privately on this node. Leave blank to retain the current connection."
        },
        {
          "key": "confirmBackendChange",
          "type": "boolean",
          "label": "I understand that switching engines does not migrate existing data",
          "default": false
        }
      ],
      "endpoints": {
        "status": "storage.status",
        "settings": "storage.settings"
      }
    }
  },
  "capabilities": [
    {
      "name": "write",
      "params": {
        "records": {
          "type": "array",
          "required": true
        }
      }
    },
    {
      "name": "query",
      "params": {
        "source": {
          "type": "string",
          "required": true
        },
        "metric": {
          "type": "string",
          "required": true
        },
        "from": {
          "type": "number",
          "required": true
        },
        "to": {
          "type": "number",
          "required": true
        },
        "filters": {
          "type": "object"
        },
        "limit": {
          "type": "integer"
        }
      },
      "description": "Query stored metrics",
      "localizations": {
        "ru": {
          "description": "Запросить сохранённые метрики"
        }
      }
    },
    {
      "name": "document_put",
      "params": {
        "namespace": {
          "type": "string",
          "required": true
        },
        "key": {
          "type": "string",
          "required": true
        },
        "value": {
          "type": "object",
          "required": true
        }
      }
    },
    {
      "name": "document_get",
      "params": {
        "namespace": {
          "type": "string",
          "required": true
        },
        "key": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "name": "document_list",
      "params": {
        "namespace": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "name": "document_delete",
      "params": {
        "namespace": {
          "type": "string",
          "required": true
        },
        "key": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "name": "health",
      "params": {},
      "description": "Storage health",
      "localizations": {
        "ru": {
          "description": "Состояние хранилища"
        }
      }
    },
    {
      "name": "settings",
      "params": {
        "values": {
          "type": "object",
          "required": false
        }
      },
      "admin": true
    },
    {
      "name": "status",
      "params": {},
      "description": "Storage status and sanitized settings",
      "localizations": {
        "ru": {
          "description": "Состояние хранилища и безопасные настройки"
        }
      }
    },
    {
      "name": "aggregate",
      "params": {},
      "description": "Aggregate producer-defined records by dimensions and time buckets"
    },
    {
      "name": "delete",
      "params": {},
      "description": "Delete records belonging to the authenticated producer"
    }
  ]
}
